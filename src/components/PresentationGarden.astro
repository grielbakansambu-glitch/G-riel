---
/**
 * G-RIEL IT GARDEN — V2
 * Présentation du Garden et principes directeurs
 */

const locale = Astro.currentLocale ?? "fr";
const isEnglish = locale === "en";

const principles = [
  {
    number: "01",
    title: isEnglish ? "Learn" : "Apprendre",
    description: isEnglish
      ? "Study, understand concepts and build solid foundations through curiosity and research."
      : "Étudier, comprendre les notions et construire des bases solides par la curiosité et la recherche.",
  },
  {
    number: "02",
    title: isEnglish ? "Practice" : "Pratiquer",
    description: isEnglish
      ? "Put theoretical knowledge into practice through experiments and personal projects."
      : "Mettre les connaissances théoriques à l'épreuve par des expérimentations et des projets pratiques.",
  },
  {
    number: "03",
    title: isEnglish ? "Document" : "Documenter",
    description: isEnglish
      ? "Explain and organize discoveries, mistakes, lessons and methods to preserve and share knowledge."
      : "Expliquer et organiser les découvertes, les erreurs, les leçons et les méthodes pour conserver et partager les connaissances.",
  },
  {
    number: "04",
    title: isEnglish ? "Progress" : "Progresser",
    description: isEnglish
      ? "Revisit what has been learned, deepen understanding and keep improving over time."
      : "Revenir sur les acquis, approfondir sa compréhension et continuer à s'améliorer au fil du temps.",
  },
];

const content = {
  eyebrow: isEnglish
    ? "ABOUT THIS DIGITAL SPACE"
    : "À PROPOS DE CET ESPACE NUMÉRIQUE",

  title: isEnglish
    ? "A space to learn, explore and build knowledge."
    : "Un espace pour apprendre, explorer et construire des connaissances.",

  introduction: isEnglish
    ? "G-RIEL IT Garden is a personal digital space dedicated to learning, exploring knowledge and documenting discoveries. I bring together notes, research, practical experiments and projects from my journey through computer science, technology, science and education."
    : "G-RIEL IT Garden est un espace numérique personnel consacré à l'apprentissage, à l'exploration des connaissances et à la documentation des découvertes. J'y rassemble des notes, des recherches, des expériences pratiques et des projets issus de mon parcours en informatique, technologie, sciences et didactique.",

  continuation: isEnglish
    ? "Knowledge is progressively organized, connected and enriched. Some publications explain concepts I have studied; others document experiments, reflections and lessons learned. I also share resources and explanations that may help others learn. The Garden grows alongside this journey."
    : "Les connaissances y sont progressivement organisées, reliées et enrichies. Certaines publications présentent des notions étudiées ; d'autres documentent des expérimentations, des réflexions et des enseignements tirés de la pratique. Je partage également des ressources et des explications susceptibles d'aider d'autres personnes à apprendre. Le Garden évolue avec ce parcours.",

  quote: isEnglish
    ? "Knowledge gains value when it is understood, practiced, connected and shared."
    : "Les connaissances prennent de la valeur lorsqu'elles sont comprises, mises en pratique, reliées et partagées.",

  quoteCaption: isEnglish
    ? "THE GARDEN'S GUIDING PRINCIPLE"
    : "LA PHILOSOPHIE DU GARDEN",

  footer: isEnglish
    ? "Not a finished destination, but a continuous journey of learning and discovery."
    : "Pas une destination achevée, mais un parcours continu d'apprentissage et de découverte.",
};
---

<section
  class="garden-presentation"
  id="presentation"
  aria-labelledby="presentation-title"
>
  <div class="presentation-container">

    <div class="presentation-heading">
      <span class="presentation-eyebrow">
        {content.eyebrow}
      </span>

      <h2 id="presentation-title">
        {content.title}
      </h2>

      <p>{content.introduction}</p>

      <p>{content.continuation}</p>
    </div>

    <div class="presentation-content">

      <div class="presentation-quote">
        <span class="quote-mark" aria-hidden="true">“</span>

        <blockquote>
          {content.quote}
        </blockquote>

        <span class="quote-caption">
          {content.quoteCaption}
        </span>
      </div>

      <div class="principles">
        {principles.map((principle) => (
          <article class="principle">
            <span class="principle-number">
              {principle.number}
            </span>

            <div>
              <h3>{principle.title}</h3>
              <p>{principle.description}</p>
            </div>
          </article>
        ))}
      </div>

    </div>

    <div class="presentation-genesis">
      <a href={`/${locale}/genesis`} class="genesis-button">
        <span>
          {isEnglish
            ? "Discover the Garden's genesis"
            : "Découvrir la genèse du Garden"}
        </span>
        <span class="genesis-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <div class="presentation-footer">
      <span class="footer-line" aria-hidden="true"></span>
      <p>{content.footer}</p>
      <span class="footer-line" aria-hidden="true"></span>
    </div>

  </div>
</section>

<style>
  /* =========================================
     GARDEN PRESENTATION — EDITORIAL DESIGN
     G-RIEL IT GARDEN
  ========================================= */

  .garden-presentation {
    padding: 110px 5%;
    /* Fond coloré subtil et texturé pour rompre la monotonie visuelle */
    background: linear-gradient(135deg, rgba(34, 61, 108, 0.04) 0%, rgba(46, 189, 79, 0.04) 100%), var(--color-surface-base, #FFFFFF);
    color: var(--color-text-primary, #0B132A);
    overflow: hidden;
    border-top: 1px solid var(--color-border-subtle, #DCE3EC);
    border-bottom: 1px solid var(--color-border-subtle, #DCE3EC);
  }

  .presentation-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* PRESENTATION HEADING */

  .presentation-heading {
    max-width: 820px;
    margin-bottom: 60px;
  }

  .presentation-eyebrow {
    display: inline-block;
    margin-bottom: 16px;
    color: var(--color-brand-green, #2EBD4F);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 2px;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .presentation-heading h2 {
    max-width: 780px;
    margin: 0;
    color: var(--color-brand-navy, #0B132A);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -1.2px;
  }

  .presentation-heading > p {
    max-width: 700px;
    margin: 24px 0 0;
    color: var(--color-text-secondary, #475467);
    font-size: 1rem;
    line-height: 1.8;
  }

  .presentation-heading > p + p {
    margin-top: 16px;
  }

  /* MAIN CONTENT */

  .presentation-content {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 60px;
    align-items: center;
  }

  /* PHILOSOPHY QUOTE */

  .presentation-quote {
    position: relative;
    padding: 40px;
    background: var(--color-surface-base, #FFFFFF);
    border: 1px solid var(--color-border-default, #DCE3EC);
    border-left: 4px solid var(--color-brand-green, #2EBD4F);
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(11, 19, 42, 0.05);
  }

  .quote-mark {
    display: block;
    color: var(--color-brand-green, #2EBD4F);
    font-family: Georgia, serif;
    font-size: 4.8rem;
    line-height: 0.75;
  }

  .presentation-quote blockquote {
    margin: 24px 0 28px;
    color: var(--color-brand-navy, #0B132A);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.3px;
  }

  .quote-caption {
    color: var(--color-brand-blue, #223D6C);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 1.4px;
    line-height: 1.5;
    text-transform: uppercase;
  }

  /* PRINCIPLES */

  .principles {
    display: grid;
    gap: 0;
  }

  .principle {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 20px;
    padding: 24px 0;
    border-bottom: 1px solid var(--color-border-subtle, #DCE3EC);
  }

  .principle:first-child {
    border-top: 1px solid var(--color-border-subtle, #DCE3EC);
  }

  .principle-number {
    color: var(--color-brand-blue, #223D6C);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.1rem;
    font-weight: 600;
    padding-top: 2px;
  }

  .principle h3 {
    margin: 0 0 6px;
    color: var(--color-brand-navy, #0B132A);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .principle p {
    margin: 0;
    color: var(--color-text-secondary, #475467);
    font-size: 0.9rem;
    line-height: 1.8;
  }

  /* GENESIS BUTTON */

  .presentation-genesis {
    margin-top: 50px;
    display: flex;
    justify-content: flex-start;
  }

  .genesis-button {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding-inline: 26px;
    border-radius: 10px;
    background: var(--color-brand-green, #2EBD4F);
    border: 1px solid var(--color-brand-green, #2EBD4F);
    color: var(--color-brand-navy, #0B132A);
    font-size: 0.88rem;
    font-weight: 750;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(46, 189, 79, 0.22);
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .genesis-button:hover {
    transform: translateY(-2px);
    background: #34cf58;
    border-color: #34cf58;
    box-shadow: 0 12px 28px rgba(46, 189, 79, 0.3);
  }

  .genesis-arrow {
    font-size: 1.15rem;
    transition: transform 180ms ease;
  }

  .genesis-button:hover .genesis-arrow {
    transform: translateX(5px);
  }

  .genesis-button:focus-visible {
    outline: 3px solid var(--color-brand-green, #2EBD4F);
    outline-offset: 4px;
  }

  /* PRESENTATION FOOTER */

  .presentation-footer {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 60px;
  }

  .presentation-footer p {
    margin: 0;
    color: var(--color-text-muted, #667085);
    font-size: 0.82rem;
    font-style: italic;
    line-height: 1.6;
    text-align: center;
    white-space: nowrap;
  }

  .footer-line {
    flex: 1;
    height: 1px;
    background: var(--color-border-default, #DCE3EC);
  }

  /* TABLET */

  @media (max-width: 860px) {
    .garden-presentation {
      padding: 80px 4%;
    }

    .presentation-content {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .presentation-heading {
      margin-bottom: 45px;
    }
  }

  /* MOBILE */

  @media (max-width: 480px) {
    .garden-presentation {
      padding: 64px 4%;
    }

    .presentation-quote {
      padding: 28px;
    }

    .principle {
      grid-template-columns: 36px 1fr;
      gap: 14px;
    }

    .presentation-genesis {
      margin-top: 36px;
    }

    .genesis-button {
      width: 100%;
      min-height: 48px;
    }

    .presentation-footer {
      gap: 12px;
      margin-top: 45px;
      flex-direction: column;
    }

    .presentation-footer p {
      white-space: normal;
    }

    .footer-line {
      width: 100%;
    }
  }

  /* ACCESSIBILITY */

  @media (prefers-reduced-motion: reduce) {
    .garden-presentation *,
    .garden-presentation *::before,
    .garden-presentation *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }

    .genesis-button:hover {
      transform: none !important;
    }
  }
</style>