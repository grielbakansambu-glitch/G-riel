---
const locale = Astro.currentLocale ?? "fr";
const isEnglish = locale === "en";

const navigation = [
  {
    label: isEnglish ? "Home" : "Accueil",
    href: `/${locale}/`,
  },
  {
    label: isEnglish ? "About" : "À propos",
    href: `/${locale}/about`,
  },
  {
    label: isEnglish ? "Roadmap" : "Feuille de route",
    href: `/${locale}/roadmap`,
  },
  {
    label: isEnglish ? "Projects" : "Projets",
    href: `/${locale}/projects`,
  },
  {
    label: isEnglish ? "Notes" : "Notes",
    href: `/${locale}/notes`,
  },
  {
    label: "Home Lab",
    href: `/${locale}/homelab`,
  },
  {
    label: isEnglish ? "Certifications" : "Certifications",
    href: `/${locale}/certifications`,
  },
  {
    label: isEnglish ? "Contact" : "Contact",
    href: `/${locale}/contact`,
  },
];

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-container">

    <!-- 1. Logo et présentation -->
    <div class="footer-top">
      <img
        src="/assets/images/logo.png"
        alt="G-RIEL IT Garden"
        class="footer-logo"
        loading="lazy"
      />

      <h3 class="footer-title">G-RIEL IT GARDEN</h3>

      <p class="footer-desc">
        {
          isEnglish
            ? "A personal digital garden dedicated to learning, research and technology."
            : "Jardin numérique personnel — Apprentissage, Recherche & Technologies."
        }
      </p>
    </div>

    <!-- 2. Navigation -->
    <nav class="footer-nav" aria-label={isEnglish ? "Footer navigation" : "Navigation du pied de page"}>
      <h4>{isEnglish ? "Navigation" : "Navigation"}</h4>

      <ul>
        {navigation.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- 3. Réseaux sociaux et contact -->
    <div class="footer-social">
      <h4>
        {isEnglish ? "Social media & Contact" : "Réseaux & Contact"}
      </h4>

      <div class="social-icons">

        <!-- Facebook -->
        <a
          href="https://www.facebook.com/share/1DQwb4sk5p/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
        >
          <svg class="svg-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"
            />
          </svg>
        </a>

        <!-- TikTok -->
        <a
          href="https://www.tiktok.com/@griel_it?_r=1&_t=ZS-98LtkOWsKlJ"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="TikTok"
        >
          <svg class="svg-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"
            />
          </svg>
        </a>

        <!-- GitHub -->
        <a
          href="https://github.com/grielbakansambu-glitch"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
        >
          <svg class="svg-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
            />
          </svg>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://www.linkedin.com/in/gabriel-bakansambu-983ba6424"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
        >
          <svg class="svg-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
            />
          </svg>
        </a>

        <!-- Email -->
        <a
          href="mailto:grielbakansambu@gmail.com"
          aria-label="Email"
        >
          <svg class="svg-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
            />
          </svg>
        </a>

        <!-- Téléphone -->
        <a
          href="tel:+243840609505"
          aria-label={isEnglish ? "Phone" : "Téléphone"}
        >
          <svg class="svg-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"
            />
          </svg>
        </a>

      </div>
    </div>

    <!-- 4. Signature -->
    <div class="footer-bottom">
      <p>
        Gabriel Bakansambu — © {currentYear} G-RIEL IT Garden
      </p>
    </div>

  </div>
</footer>

<style>
.site-footer {
  background-color: #0b132b;
  color: #c5c5c5;
  padding: 50px 20px 20px;
  border-top: 1px solid #1c2541;
  font-family: inherit;
}

.footer-container {
  max-width: 800px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 40px;
}

.footer-top {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.footer-logo {
  width: 150px;
  height: auto;
  margin-bottom: 15px;
}

.footer-title {
  font-size: 1.2rem;
  color: #ffffff;
  font-weight: bold;
  letter-spacing: 1px;
  margin-bottom: 8px;
}

.footer-desc {
  font-size: 0.95rem;
  color: #8d99ae;
  max-width: 450px;
  margin: 0;
  line-height: 1.7;
}

.footer-nav h4,
.footer-social h4 {
  font-size: 0.9rem;
  color: #ffffff;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 15px;
}

.footer-nav ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 15px 25px;
}

.footer-nav ul li a {
  color: #a0aabf;
  text-decoration: none;
  font-size: 0.95rem;
  transition: color 0.2s;
}

.footer-nav ul li a:hover {
  color: #58B80C;
}

.social-icons {
  display: flex;
  justify-content: center;
  gap: 15px;
  flex-wrap: wrap;
}

.social-icons a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px;
  background: #1c2541;
  border-radius: 50%;
  color: #ffffff;
  transition: all 0.2s ease;
}

.social-icons a:hover {
  background: #58B80C;
  color: #0b132b;
  transform: translateY(-3px);
}

.svg-icon {
  width: 20px;
  height: 20px;
}

.footer-bottom {
  border-top: 1px solid #1c2541;
  width: 100%;
  padding-top: 20px;
  font-size: 0.85rem;
  color: #8d99ae;
}

.footer-bottom p {
  margin: 0;
}

.site-footer :focus-visible {
  outline: 2px solid var(--color-focus, #58B80C);
  outline-offset: 3px;
  border-radius: 4px;
}

@media (max-width: 600px) {
  .site-footer {
    padding: 40px 16px 20px;
  }

  .footer-container {
    gap: 32px;
  }

  .footer-nav ul {
    gap: 14px 18px;
  }

  .social-icons {
    gap: 12px;
  }
}
</style>