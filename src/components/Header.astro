---
const locale = Astro.currentLocale ?? "fr";
const isEnglish = locale === "en";

const navItems = [
  {
    label: isEnglish ? "Home" : "Accueil",
    href: `/${locale}/`,
  },
  {
    label: isEnglish ? "Garden Map" : "Carte du jardin",
    href: `/${locale}/map`,
  },
  {
    label: isEnglish ? "About" : "À propos",
    href: `/${locale}/about`,
  },
  {
    label: "Roadmap",
    href: `/${locale}/roadmap`,
  },
  {
    label: isEnglish ? "Projects" : "Projets",
    href: `/${locale}/projects`,
  },
  {
    label: "Notes",
    href: `/${locale}/notes`,
  },
  {
    label: "Home Lab",
    href: `/${locale}/homelab`,
  },
  {
    label: isEnglish ? "Certifications" : "Certifications",
    href: `/${locale}/certifications`,
  },
  {
    label: isEnglish ? "Contact" : "Contact",
    href: `/${locale}/contact`,
  },
];
---

<header class="site-header">
  <div class="header-inner">

    <!-- BRAND -->
    <a
      href={`/${locale}/`}
      class="brand"
      aria-label="G-RIEL IT Garden — Home"
    >
      <img
        src="/assets/images/logo.png"
        alt=""
        class="brand-logo"
      />

      <span class="brand-name">
        <strong>G-RIEL</strong>
        <span>IT Garden</span>
      </span>
    </a>

    <!-- ACTIONS -->
    <div class="header-actions">

      <!-- LANGUAGE SWITCHER -->
      <nav class="language-switcher" aria-label={isEnglish ? "Language selection" : "Choix de la langue"}>
        <a
          href="/fr/"
          lang="fr"
          class:list={{ active: locale === "fr" }}
          aria-current={locale === "fr" ? "page" : undefined}
        >
          FR
        </a>

        <span aria-hidden="true" class="lang-separator">|</span>

        <a
          href="/en/"
          lang="en"
          class:list={{ active: locale === "en" }}
          aria-current={locale === "en" ? "page" : undefined}
        >
          EN
        </a>
      </nav>

      <!-- SEARCH -->
      <form class="search" role="search" onsubmit="return false">
        <label for="site-search" class="sr-only">
          {isEnglish ? "Search the Garden" : "Rechercher dans le Garden"}
        </label>

        <span class="search-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <circle cx="11" cy="11" r="6.5" />
            <path d="M16 16L21 21" />
          </svg>
        </span>

        <input
          id="site-search"
          type="search"
          placeholder={isEnglish ? "Search..." : "Rechercher..."}
          autocomplete="off"
        />
      </form>

      <!-- MENU BUTTON -->
      <button
        class="menu-button"
        type="button"
        aria-label={isEnglish ? "Open menu" : "Ouvrir le menu"}
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>

    </div>
  </div>

  <div class="header-accent" aria-hidden="true"></div>
</header>

<!-- OVERLAY -->
<div class="menu-overlay" aria-hidden="true"></div>

<!-- SIDE MENU -->
<aside
  id="site-menu"
  class="site-menu"
  aria-hidden="true"
  aria-label={isEnglish ? "Main navigation" : "Navigation principale"}
>
  <div class="menu-header">
    <div>
      <span class="menu-label">
        {isEnglish ? "EXPLORE" : "EXPLORER"}
      </span>

      <h2>G-RIEL IT Garden</h2>
    </div>

    <button
      class="menu-close"
      type="button"
      aria-label={isEnglish ? "Close menu" : "Fermer le menu"}
    >
      <span></span>
      <span></span>
    </button>
  </div>

  <nav aria-label={isEnglish ? "Main navigation" : "Navigation principale"}>
    <ul>
      {
        navItems.map((item, index) => (
          <li style={`--item-index: ${index};`}>
            <a href={item.href}>
              <span>{item.label}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="menu-footer">
    <p>
      {
        isEnglish
          ? "Explore, understand, learn."
          : "Explorer, comprendre, apprendre."
      }
    </p>
  </div>
</aside>

<script>
  const menuButton = document.querySelector(".menu-button");
  const menuClose = document.querySelector(".menu-close");
  const menu = document.querySelector(".site-menu");
  const overlay = document.querySelector(".menu-overlay");
  const siteHeader = document.querySelector(".site-header");

  // Header scroll state for subtle glassmorphism & shadow on scroll
  window.addEventListener("scroll", () => {
    if (window.scrollY > 15) {
      siteHeader?.classList.add("is-scrolled");
    } else {
      siteHeader?.classList.remove("is-scrolled");
    }
  }, { passive: true });

  if (menuButton && menu && overlay && menuClose) {
    const openMenu = () => {
      menu.classList.add("is-open");
      overlay.classList.add("is-visible");

      menu.setAttribute("aria-hidden", "false");
      overlay.setAttribute("aria-hidden", "false");
      menuButton.setAttribute("aria-expanded", "true");

      menuButton.setAttribute(
        "aria-label",
        document.documentElement.lang === "en"
          ? "Close menu"
          : "Fermer le menu"
      );

      document.body.classList.add("menu-open");
    };

    const closeMenu = () => {
      menu.classList.remove("is-open");
      overlay.classList.remove("is-visible");

      menu.setAttribute("aria-hidden", "true");
      overlay.setAttribute("aria-hidden", "true");
      menuButton.setAttribute("aria-expanded", "false");

      menuButton.setAttribute(
        "aria-label",
        document.documentElement.lang === "en"
          ? "Open menu"
          : "Ouvrir le menu"
      );

      document.body.classList.remove("menu-open");
    };

    menuButton.addEventListener("click", () => {
      const isOpen = menu.classList.contains("is-open");

      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    menuClose.addEventListener("click", closeMenu);
    overlay.addEventListener("click", closeMenu);

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMenu();
      }
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--color-surface-base, #FFFFFF);
    border-bottom: 1px solid var(--color-border-subtle, #DCE3EC);
    transition: background-color 240ms ease, box-shadow 240ms ease, border-color 240ms ease;
  }

  .site-header.is-scrolled {
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 6px 24px rgba(11, 19, 42, 0.07);
    border-bottom-color: rgba(220, 227, 236, 0.85);
  }

  .header-inner {
    width: min(100% - 2.5rem, 1280px);
    min-height: 76px;
    margin-inline: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  /* BRAND */

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;

    color: var(--color-text-primary, #0B132A);
    text-decoration: none;
    transition: opacity 160ms ease;
  }

  .brand:hover {
    opacity: 0.88;
  }

  .brand-logo {
    width: 44px;
    height: 44px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .brand-name {
    display: flex;
    flex-direction: column;
    line-height: 1;
    white-space: nowrap;
  }

  .brand-name strong {
    color: var(--color-brand-navy, #0B132A);
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .brand-name span {
    margin-top: 0.28rem;
    color: var(--color-brand-green, #2EBD4F);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* ACTIONS */

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  /* LANGUAGE SWITCHER */

  .language-switcher {
    display: flex;
    align-items: center;
    gap: 0.45rem;

    color: var(--color-text-muted, #667085);
    font-size: 0.82rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .language-switcher a {
    color: var(--color-text-muted, #667085);
    text-decoration: none;
    padding: 0.2rem 0.35rem;
    border-radius: 4px;
    transition: color 160ms ease, background-color 160ms ease;
  }

  .language-switcher a:hover {
    color: var(--color-brand-green, #2EBD4F);
    background: var(--color-surface-subtle, #F3F6FA);
  }

  .language-switcher a.active {
    color: var(--color-brand-green, #2EBD4F);
    font-weight: 900;
    background: rgba(46, 189, 79, 0.08);
  }

  .lang-separator {
    color: var(--color-border-default, #DCE3EC);
    font-weight: 400;
  }

  /* SEARCH */

  .search {
    position: relative;
    width: 280px;
  }

  .search input {
    width: 100%;
    height: 42px;
    padding: 0 1rem 0 2.75rem;

    border: 1px solid var(--color-border-default, #DCE3EC);
    border-radius: 10px;

    background: var(--color-surface-subtle, #F3F6FA);
    color: var(--color-text-primary, #0B132A);
    font-size: 0.9rem;

    outline: none;

    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  .search input::placeholder {
    color: var(--color-text-muted, #667085);
  }

  .search input:hover {
    border-color: var(--color-border-strong, #CBD5E1);
    background: var(--color-surface-base, #FFFFFF);
  }

  .search input:focus {
    border-color: var(--color-brand-green, #2EBD4F);
    background: var(--color-surface-base, #FFFFFF);
    box-shadow: 0 0 0 3px rgba(46, 189, 79, 0.15);
  }

  .search-icon {
    position: absolute;
    left: 0.95rem;
    top: 50%;

    width: 17px;
    height: 17px;

    transform: translateY(-50%);
    color: var(--color-text-muted, #667085);
    pointer-events: none;
    transition: color 180ms ease;
  }

  .search:focus-within .search-icon {
    color: var(--color-brand-green, #2EBD4F);
  }

  .search-icon svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  /* MENU BUTTON */

  .menu-button {
    width: 42px;
    height: 42px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;

    border: 1px solid var(--color-border-default, #DCE3EC);
    border-radius: 10px;

    background: var(--color-surface-base, #FFFFFF);
    cursor: pointer;

    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .menu-button span {
    display: block;
    width: 18px;
    height: 2px;
    border-radius: 2px;

    background: var(--color-brand-navy, #0B132A);

    transition:
      transform 200ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 200ms ease;
  }

  .menu-button:hover {
    border-color: var(--color-brand-green, #2EBD4F);
    background: var(--color-surface-subtle, #F3F6FA);
  }

  .menu-button:active {
    transform: scale(0.96);
  }

  .menu-button[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-button[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .menu-button[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* HEADER ACCENT */

  .header-accent {
    width: 100%;
    height: 2px;

    background: linear-gradient(
      90deg,
      var(--color-brand-navy, #0B132A) 0%,
      var(--color-brand-blue, #223D6C) 55%,
      var(--color-brand-green, #2EBD4F) 100%
    );
  }

  /* OVERLAY */

  .menu-overlay {
    position: fixed;
    inset: 0;
    z-index: 1100;

    background: rgba(11, 19, 42, 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);

    opacity: 0;
    visibility: hidden;

    transition:
      opacity 240ms ease,
      visibility 240ms ease;
  }

  .menu-overlay.is-visible {
    opacity: 1;
    visibility: visible;
  }

  /* SIDE MENU */

  .site-menu {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 1200;

    width: min(420px, 92vw);
    height: 100dvh;

    display: flex;
    flex-direction: column;

    padding: 2.5rem;

    background: var(--color-surface-base, #FFFFFF);
    border-left: 1px solid var(--color-border-default, #DCE3EC);
    box-shadow: -28px 0 64px rgba(11, 19, 42, 0.16);

    transform: translateX(100%);
    visibility: hidden;

    transition:
      transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 320ms ease;
  }

  .site-menu.is-open {
    transform: translateX(0);
    visibility: visible;
  }

  .site-menu.is-open li {
    opacity: 1;
    transform: translateY(0);
  }

  .menu-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border-subtle, #DCE3EC);
  }

  .menu-label {
    display: block;
    margin-bottom: 0.35rem;

    color: var(--color-brand-green, #2EBD4F);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  .menu-header h2 {
    color: var(--color-brand-navy, #0B132A);
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .menu-close {
    position: relative;
    width: 40px;
    height: 40px;

    border: 1px solid var(--color-border-default, #DCE3EC);
    border-radius: 8px;

    background: var(--color-surface-base, #FFFFFF);
    cursor: pointer;
    transition: background-color 160ms ease, border-color 160ms ease;
  }

  .menu-close:hover {
    background: var(--color-surface-subtle, #F3F6FA);
    border-color: var(--color-brand-green, #2EBD4F);
  }

  .menu-close span {
    position: absolute;
    left: 10px;
    top: 19px;
    width: 18px;
    height: 2px;
    background: var(--color-brand-navy, #0B132A);
    border-radius: 2px;
  }

  .menu-close span:first-child {
    transform: rotate(45deg);
  }

  .menu-close span:last-child {
    transform: rotate(-45deg);
  }

  .site-menu nav {
    flex: 1;
    overflow-y: auto;
    padding-block: 1.25rem;
    scrollbar-width: thin;
  }

  .site-menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-menu li {
    border-bottom: 1px solid var(--color-border-subtle, #DCE3EC);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 260ms ease calc(var(--item-index, 0) * 35ms + 90ms),
                transform 260ms cubic-bezier(0.16, 1, 0.3, 1) calc(var(--item-index, 0) * 35ms + 90ms);
  }

  .site-menu a {
    min-height: 56px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    color: var(--color-text-primary, #0B132A);
    font-weight: 600;
    font-size: 1.02rem;
    text-decoration: none;

    transition:
      color 160ms ease,
      padding-left 160ms ease;
  }

  .site-menu a:hover {
    padding-left: 0.5rem;
    color: var(--color-brand-blue, #223D6C);
  }

  .arrow {
    color: var(--color-brand-green, #2EBD4F);
    font-size: 1.2rem;
    font-weight: 700;
    transition: transform 160ms ease;
  }

  .site-menu a:hover .arrow {
    transform: translateX(4px);
  }

  .menu-footer {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-subtle, #DCE3EC);
  }

  .menu-footer p {
    color: var(--color-text-muted, #667085);
    font-size: 0.88rem;
    font-style: italic;
  }

  body.menu-open {
    overflow: hidden;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* MOBILE */

  @media (max-width: 700px) {
    .header-inner {
      width: min(100% - 1.25rem, 1280px);
      min-height: 68px;
      gap: 0.75rem;
    }

    .brand {
      gap: 0.6rem;
    }

    .brand-logo {
      width: 38px;
      height: 38px;
    }

    .brand-name strong {
      font-size: 0.95rem;
    }

    .brand-name span {
      font-size: 0.68rem;
      margin-top: 0.2rem;
    }

    .header-actions {
      flex: 1;
      min-width: 0;
      justify-content: flex-end;
      gap: 0.6rem;
    }

    .search {
      width: min(200px, 100%);
      min-width: 0;
    }

    .search input {
      height: 40px;
      padding-left: 2.5rem;
      font-size: 0.88rem;
    }

    .menu-button {
      width: 40px;
      height: 40px;
      flex-shrink: 0;
    }

    .site-menu {
      width: min(390px, 94vw);
      padding: 1.85rem;
    }
  }

  @media (max-width: 480px) {
    .header-inner {
      gap: 0.5rem;
    }

    .brand-name span {
      display: none;
    }

    .brand-name strong {
      font-size: 0.85rem;
    }

    .brand-logo {
      width: 34px;
      height: 34px;
    }

    .header-actions {
      gap: 0.45rem;
    }

    .search {
      width: 105px;
    }

    .search input {
      padding-left: 2.1rem;
      padding-right: 0.4rem;
    }

    .language-switcher {
      gap: 0.3rem;
      font-size: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>