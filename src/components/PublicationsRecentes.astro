---
/**
 * G-RIEL IT GARDEN — V2
 * Publications récentes
 */

const locale = Astro.currentLocale ?? "fr";
const isEnglish = locale === "en";

const publications = [
  {
    number: "01",
    category: isEnglish ? "TEACHING INTERNSHIP" : "STAGE PÉDAGOGIQUE",
    title: isEnglish
      ? "Teaching Internship II — Lycée Kivuvu"
      : "Stage pédagogique II — Lycée Kivuvu",
    description: isEnglish
      ? "Field experience, classroom practice, teaching activities and observations documented throughout the internship."
      : "Expérience sur le terrain, pratique de classe, activités pédagogiques et observations documentées durant le stage.",
    date: "2026",
    href: `/${locale}/publications/stage-pedagogique-ii`,
  },
  {
    number: "02",
    category: isEnglish ? "ACADEMIC PROJECT" : "PROJET ACADÉMIQUE",
    title: isEnglish
      ? "Final-year project"
      : "Projet de Travail de Fin de Cycle",
    description: isEnglish
      ? "Research, ideas, methodology and progress on an academic project in Information Technology."
      : "Recherches, réflexions, méthodologie et progression autour d'un projet académique en informatique et technologie.",
    date: "2026",
    href: `/${locale}/publications/projet-tfc`,
  },
];
---

<section
  class="publications"
  id="publications"
  aria-labelledby="publications-title"
>
  <div class="publications-container">

    <div class="publications-heading">
      <div class="section-intro">
        <span class="section-eyebrow">
          {isEnglish ? "KNOWLEDGE IN MOTION" : "LE SAVOIR EN MOUVEMENT"}
        </span>

        <h2 id="publications-title">
          {isEnglish ? "Recent publications" : "Publications récentes"}
          <span>.</span>
        </h2>

        <p>
          {
            isEnglish
              ? "Academic work, field experiences and projects documented along the way."
              : "Travaux académiques, expériences de terrain et projets documentés au fil du parcours."
          }
        </p>
      </div>

      <span class="publication-count">
        02
        <small>
          {isEnglish ? "PUBLICATIONS" : "PUBLICATIONS"}
        </small>
      </span>
    </div>

    <div class="publications-grid">
      {
        publications.map((publication) => (
          <article class="publication-card">
            <div class="card-top">
              <span class="card-number">
                {publication.number}
              </span>

              <span class="card-category">
                {publication.category}
              </span>
            </div>

            <div class="card-content">
              <span class="card-date">
                {publication.date}
              </span>

              <h3>{publication.title}</h3>

              <p>{publication.description}</p>
            </div>

            <a
              class="publication-link"
              href={publication.href}
            >
              <span>
                {
                  isEnglish
                    ? "Explore publication"
                    : "Découvrir la publication"
                }
              </span>

              <svg
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M5 12h14M13 5l7 7-7 7"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </article>
        ))
      }
    </div>

  </div>
</section>

<style>
  /* =========================================
     PUBLICATIONS — EDITORIAL DESIGN
     G-RIEL IT GARDEN
  ========================================= */

  .publications {
    position: relative;
    padding: 110px 5%;
    background: var(--color-surface-subtle, #F3F6FA);
    color: var(--color-text-primary, #0B132A);
    border-top: 1px solid var(--color-border-subtle, #DCE3EC);
    border-bottom: 1px solid var(--color-border-subtle, #DCE3EC);
  }

  .publications-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* HEADER */

  .publications-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px;
    margin-bottom: 50px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--color-border-default, #DCE3EC);
  }

  .section-intro {
    min-width: 0;
  }

  .section-eyebrow {
    display: inline-block;
    margin-bottom: 16px;
    color: var(--color-brand-green, #2EBD4F);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 2px;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .section-intro h2 {
    margin: 0;
    color: var(--color-brand-navy, #0B132A);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    font-weight: 600;
    letter-spacing: -1.2px;
    line-height: 1.15;
  }

  .section-intro h2 span {
    color: var(--color-brand-green, #2EBD4F);
  }

  .section-intro p {
    max-width: 620px;
    margin: 16px 0 0;
    color: var(--color-text-secondary, #475467);
    font-size: 1rem;
    line-height: 1.8;
  }

  /* PUBLICATION COUNTER */

  .publication-count {
    flex-shrink: 0;
    color: var(--color-brand-blue, #223D6C);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 2.8rem;
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
  }

  .publication-count small {
    display: block;
    margin-top: 8px;
    color: var(--color-text-muted, #667085);
    font-family: Arial, sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-align: right;
  }

  /* PUBLICATION GRID */

  .publications-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }

  /* DOCUMENT CARD */

  .publication-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 32px 32px 26px;
    background: var(--color-surface-base, #FFFFFF);
    border: 1px solid var(--color-border-default, #DCE3EC);
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(11, 19, 42, 0.03);
    transition:
      border-color 200ms ease,
      box-shadow 200ms ease,
      transform 200ms ease;
  }

  .publication-card::before {
    position: absolute;
    top: 0;
    left: 24px;
    right: 24px;
    height: 3px;
    background: var(--color-brand-green, #2EBD4F);
    content: "";
    border-radius: 0 0 3px 3px;
  }

  .publication-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-brand-green, #2EBD4F);
    box-shadow: 0 12px 32px rgba(11, 19, 42, 0.08);
  }

  /* CARD METADATA */

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-border-subtle, #DCE3EC);
  }

  .card-number {
    color: var(--color-brand-blue, #223D6C);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .card-category {
    display: inline-block;
    padding: 5px 10px;
    color: var(--color-brand-navy, #0B132A);
    background: var(--color-surface-subtle, #F3F6FA);
    border: 1px solid var(--color-border-default, #DCE3EC);
    border-radius: 6px;
    font-size: 0.65rem;
    font-weight: 750;
    letter-spacing: 0.8px;
    line-height: 1.4;
  }

  /* CARD CONTENT */

  .card-content {
    flex: 1;
    padding: 24px 0 28px;
  }

  .card-date {
    display: inline-block;
    color: var(--color-text-muted, #667085);
    font-family: Arial, sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.6px;
  }

  .card-content h3 {
    margin: 12px 0 12px;
    color: var(--color-brand-navy, #0B132A);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.35rem, 2vw, 1.6rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.3px;
  }

  .card-content p {
    margin: 0;
    color: var(--color-text-secondary, #475467);
    font-size: 0.92rem;
    font-weight: 400;
    line-height: 1.8;
  }

  /* DOCUMENT LINK */

  .publication-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding-top: 18px;
    color: var(--color-brand-blue, #223D6C);
    border-top: 1px solid var(--color-border-subtle, #DCE3EC);
    font-size: 0.84rem;
    font-weight: 750;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .publication-link span {
    line-height: 1.5;
  }

  .publication-link svg {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    transition: transform 160ms ease;
  }

  .publication-link:hover {
    color: var(--color-brand-green, #2EBD4F);
  }

  .publication-link:hover svg {
    transform: translateX(4px);
  }

  .publication-link:focus-visible {
    outline: 3px solid var(--color-brand-green, #2EBD4F);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* RESPONSIVE — TABLET */

  @media (max-width: 760px) {
    .publications {
      padding: 80px 4%;
    }

    .publications-heading {
      align-items: flex-start;
      gap: 20px;
      margin-bottom: 36px;
    }

    .publication-count {
      font-size: 2.2rem;
    }

    .publications-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .publication-card {
      padding: 26px 22px;
    }
  }

  /* RESPONSIVE — MOBILE */

  @media (max-width: 480px) {
    .publications {
      padding: 64px 4%;
    }

    .publications-heading {
      flex-direction: column;
      gap: 16px;
    }

    .section-eyebrow {
      font-size: 0.64rem;
      letter-spacing: 1.6px;
    }

    .section-intro h2 {
      font-size: 2rem;
    }

    .section-intro p {
      font-size: 0.9rem;
      line-height: 1.75;
    }

    .publication-count {
      font-size: 1.8rem;
    }

    .publication-count small {
      text-align: left;
    }

    .publication-card {
      padding: 22px 18px;
    }

    .card-top {
      align-items: flex-start;
    }

    .card-category {
      max-width: 80%;
      font-size: 0.6rem;
    }

    .card-content h3 {
      font-size: 1.35rem;
    }
  }

  /* ACCESSIBILITY */

  @media (prefers-reduced-motion: reduce) {
    .publication-card,
    .publication-link,
    .publication-link svg {
      transition: none !important;
    }

    .publication-card:hover {
      transform: none !important;
    }
  }
</style>