---
/**
 * G-RIEL IT GARDEN — V2
 * Accès rapides bilingues
 */

const locale = Astro.currentLocale ?? "fr";
const isEnglish = locale === "en";

const quickLinks = [
  {
    title: isEnglish ? "Garden Map" : "Carte du jardin",
    href: `/${locale}/map`,
    icon: "map",
  },
  {
    title: isEnglish ? "Notes & Courses" : "Notes & cours",
    href: `/${locale}/notes`,
    icon: "notes",
  },
  {
    title: isEnglish ? "Projects" : "Projets",
    href: `/${locale}/projects`,
    icon: "projects",
  },
  {
    title: "Home Lab",
    href: `/${locale}/homelab`,
    icon: "server",
  },
  {
    title: "Roadmap",
    href: `/${locale}/roadmap`,
    icon: "roadmap",
  },
  {
    title: isEnglish ? "Certifications" : "Certifications",
    href: `/${locale}/certifications`,
    icon: "certificate",
  },
  {
    title: isEnglish ? "Profile & CV" : "Parcours & CV",
    href: `/${locale}/cv`,
    icon: "cv",
  },
  {
    title: "GitHub",
    href: "https://github.com/grielbakansambu-glitch",
    icon: "github",
  },
];
---

<section class="quick-access" aria-labelledby="quick-access-title">
  <div class="quick-access__container">
    <h2 id="quick-access-title" class="sr-only">
      {isEnglish ? "Quick access" : "Accès rapides"}
    </h2>

    <nav
      class="quick-access__nav"
      aria-label={
        isEnglish
          ? "Garden quick navigation"
          : "Navigation rapide du jardin"
      }
    >
      {
        quickLinks.map((link) => (
          <a
            class="quick-access__item"
            href={link.href}
            {...(
              link.href.startsWith("http")
                ? {
                    target: "_blank",
                    rel: "noopener noreferrer",
                  }
                : {}
            )}
          >
            <span class="quick-access__circle" aria-hidden="true">

              {link.icon === "map" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M9 18 3 21V6l6-3 6 3 6-3v15l-6 3-6-3Z" />
                  <path d="M9 3v15M15 6v15" />
                </svg>
              )}

              {link.icon === "notes" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M6 3h9l4 4v14H6V3Z" />
                  <path d="M15 3v5h4M9 12h6M9 16h6" />
                </svg>
              )}

              {link.icon === "projects" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14" />
                </svg>
              )}

              {link.icon === "server" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <rect x="3" y="4" width="18" height="6" rx="1" />
                  <rect x="3" y="14" width="18" height="6" rx="1" />
                  <path d="M7 7h.01M7 17h.01M11 7h6M11 17h6" />
                </svg>
              )}

              {link.icon === "roadmap" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M4 19c4-1 4-6 8-7s4-6 8-7" />
                  <circle cx="4" cy="19" r="2" />
                  <circle cx="12" cy="12" r="2" />
                  <circle cx="20" cy="5" r="2" />
                </svg>
              )}

              {link.icon === "certificate" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="9" r="6" />
                  <path d="m9 14-1 7 4-2 4 2-1-7" />
                  <path d="m9.5 9 1.7 1.7L14.5 7.5" />
                </svg>
              )}

              {link.icon === "cv" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M6 3h9l4 4v14H6V3Z" />
                  <path d="M15 3v5h4" />
                  <circle cx="10" cy="13" r="2" />
                  <path d="M8 18c.6-1.2 1.3-1.8 2-1.8s1.4.6 2 1.8M13 13h3M13 17h3" />
                </svg>
              )}

              {link.icon === "github" && (
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                  <path d="M9 18c-4.51 2-5-2-7-2" />
                </svg>
              )}

            </span>

            <span class="quick-access__title">
              {link.title}
            </span>
          </a>
        ))
      }
    </nav>
  </div>
</section>

<style>
  .quick-access {
    width: 100%;
    padding: 24px 0;
    background: var(--color-surface-base, #FFFFFF);
    border-top: 1px solid var(--color-border-subtle, #DCE3EC);
    border-bottom: 1px solid var(--color-border-subtle, #DCE3EC);
    box-shadow: 0 4px 16px rgba(11, 19, 42, 0.04);
  }

  .quick-access__container {
    width: min(1200px, 100%);
    margin: 0 auto;
    padding: 0 20px;
  }

  .quick-access__nav {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 12px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 4px;
  }

  .quick-access__nav::-webkit-scrollbar {
    display: none;
  }

  .quick-access__item {
    flex: 1;
    min-width: 110px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 12px 8px;
    border-radius: 10px;
    background: transparent;
    color: var(--color-text-primary, #0B132A);
    text-decoration: none;
    text-align: center;
    transition:
      background-color 180ms ease,
      transform 180ms ease,
      border-color 180ms ease;
    border: 1px solid transparent;
  }

  .quick-access__circle {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid var(--color-border-default, #DCE3EC);
    background: var(--color-surface-subtle, #F3F6FA);
    display: grid;
    place-items: center;
    color: var(--color-brand-blue, #223D6C);
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .quick-access__circle svg {
    width: 20px;
    height: 20px;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .quick-access__title {
    font-size: 0.82rem;
    font-weight: 650;
    line-height: 1.35;
    color: var(--color-text-secondary, #475467);
    max-width: 120px;
    transition: color 180ms ease;
  }

  .quick-access__item:hover {
    background: var(--color-surface-subtle, #F3F6FA);
    border-color: rgba(220, 227, 236, 0.8);
    transform: translateY(-2px);
  }

  .quick-access__item:hover .quick-access__circle {
    background: var(--color-brand-navy, #0B132A);
    border-color: var(--color-brand-navy, #0B132A);
    color: var(--color-brand-green, #2EBD4F);
    box-shadow: 0 6px 16px rgba(11, 19, 42, 0.12);
  }

  .quick-access__item:hover .quick-access__title {
    color: var(--color-brand-navy, #0B132A);
  }

  .quick-access__item:focus-visible {
    outline: 3px solid var(--color-brand-green, #2EBD4F);
    outline-offset: 3px;
    border-radius: 8px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 960px) {
    .quick-access {
      padding: 18px 0;
    }

    .quick-access__container {
      padding: 0 14px;
    }

    .quick-access__nav {
      justify-content: flex-start;
      gap: 8px;
    }

    .quick-access__item {
      flex: 0 0 96px;
      min-width: unset;
      padding: 10px 4px;
    }

    .quick-access__circle {
      width: 42px;
      height: 42px;
    }

    .quick-access__circle svg {
      width: 18px;
      height: 18px;
    }

    .quick-access__title {
      font-size: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .quick-access__item,
    .quick-access__circle,
    .quick-access__title {
      transition: none !important;
    }
  }
</style>